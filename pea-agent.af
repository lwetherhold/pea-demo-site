    {
      "id": "tool-9",
      "tool_type": "custom",
      "description": "Fetch details about an existing Letta tool including its source code.\n\nThis tool retrieves complete information about a Letta tool by its ID,\nincluding source code, description, tags, requirements, and all other\nconfiguration settings. Useful for inspecting tools before editing them.\n\nExamples:\n        >>> get_letta_tool(\"tool-abc123\")\n        Returns formatted output with tool name, ID, description, tags, and full source code.",
      "source_type": "json",
      "name": "get_letta_tool",
      "tags": [
        "letta",
        "tool-management",
        "api",
        "read"
      ],
      "source_code": "import os\nimport requests\nimport json\n\ndef get_letta_tool(tool_id: str) -> str:\n    \"\"\"Fetch details about an existing Letta tool including its source code.\n    \n    This tool retrieves complete information about a Letta tool by its ID,\n    including source code, description, tags, requirements, and all other\n    configuration settings. Useful for inspecting tools before editing them.\n    \n    Args:\n        tool_id (str): The ID of the tool to fetch (e.g., \"tool-abc123...\").\n    \n    Returns:\n        str: Formatted tool information including source code and metadata,\n             or an error message if the tool cannot be retrieved.\n    \n    Examples:\n        >>> get_letta_tool(\"tool-abc123\")\n        Returns formatted output with tool name, ID, description, tags, and full source code.\n    \"\"\"\n    try:\n        # Get base URL and token from environment\n        base_url = os.getenv(\"LETTA_BASE_URL\")\n        token = os.getenv(\"LETTA_API_KEY\")\n        \n        if not base_url:\n            return \"❌ Error: LETTA_BASE_URL not found in environment variables\"\n        \n        if not token:\n            return \"❌ Error: LETTA_API_KEY not found in environment variables\"\n        \n        # Make API request to get tool\n        headers = {\n            \"Authorization\": f\"Bearer {token}\",\n            \"Content-Type\": \"application/json\"\n        }\n        \n        url = f\"{base_url}/v1/tools/{tool_id}\"\n        response = requests.get(url, headers=headers)\n        \n        if response.status_code == 200:\n            data = response.json()\n            \n            # Format the response nicely\n            output = f\"\"\"✅ TOOL INFORMATION\n\nTool Name: {data.get('name', 'N/A')}\nTool ID: {data.get('id', 'N/A')}\nDescription: {data.get('description', 'N/A')}\nTags: {data.get('tags', [])}\nRequires Approval: {data.get('requires_approval', False)}\nReturn Char Limit: {data.get('return_char_limit', 'N/A')}\n\nPip Requirements: {data.get('pip_requirements', [])}\nNpm Requirements: {data.get('npm_requirements', [])}\n\nSOURCE CODE:\n{'-' * 80}\n{data.get('source_code', 'No source code available')}\n{'-' * 80}\n\"\"\"\n            return output\n            \n        elif response.status_code == 404:\n            return f\"❌ Error: Tool with ID '{tool_id}' not found\"\n        else:\n            return f\"❌ Error: API returned status {response.status_code}: {response.text}\"\n            \n    except requests.exceptions.RequestException as e:\n        return f\"❌ Network error: {str(e)}\"\n    except Exception as e:\n        return f\"❌ Unexpected error: {str(e)}\"",
      "json_schema": {
        "name": "get_letta_tool",
        "description": "Fetch details about an existing Letta tool including its source code.\n\nThis tool retrieves complete information about a Letta tool by its ID,\nincluding source code, description, tags, requirements, and all other\nconfiguration settings. Useful for inspecting tools before editing them.\n\nExamples:\n        >>> get_letta_tool(\"tool-abc123\")\n        Returns formatted output with tool name, ID, description, tags, and full source code.",
        "parameters": {
          "type": "object",
          "properties": {
            "tool_id": {
              "type": "string",
              "description": "The ID of the tool to fetch (e.g., \"tool-abc123...\")."
            }
          },
          "required": [
            "tool_id"
          ]
        }
      },
      "args_json_schema": null,
      "return_char_limit": 50000,
      "pip_requirements": [
        {
          "name": "requests",
          "version": null
        }
      ],
      "npm_requirements": null,
      "default_requires_approval": null,
      "enable_parallel_execution": false,
      "created_by_id": "user-ad28d87a-79db-41a4-8bae-39585a0719e0",
      "last_updated_by_id": "user-e3aa725a-e3b6-462e-a497-ccc5117183b0",

    {
      "id": "tool-2",
      "tool_type": "custom",
      "description": "Updates the character limit for a specific memory block within an agent.",
      "source_type": "python",
      "name": "memory_update_size",
      "tags": [],
      "source_code": "import os\n\ndef memory_update_size(block_label:str, new_block_limit: int):\n    \"\"\"\n    Updates the character limit for a specific memory block within an agent.\n\n    Args:\n        block_label: The label identifying the specific memory block (e.g., 'human', 'persona').\n        new_block_limit: The new maximum character limit for the specified memory block.\n    \"\"\"\n    try:\n        ## check if block exists\n        block_response = client.agents.blocks.retrieve(\n            block_label=block_label,\n            agent_id=os.getenv(\"LETTA_AGENT_ID\"),\n        )\n        ## apply size increase\n        updated_response = client.agents.blocks.update(\n            block_label=block_label,\n            agent_id=os.getenv(\"LETTA_AGENT_ID\"),\n            limit=new_block_limit\n        )\n\n        return updated_response\n\n    except Exception as e:\n        error_message = f\"Error updating block '{block_label}': {str(e)}\"\n        return {\"error\": error_message}\n",
      "json_schema": {
        "name": "memory_update_size",
        "description": "Updates the character limit for a specific memory block within an agent.",
        "parameters": {
          "type": "object",
          "properties": {
            "block_label": {
              "type": "string",
              "description": "The label identifying the specific memory block (e.g., 'human', 'persona')."
            },
            "new_block_limit": {
              "type": "integer",
              "description": "The new maximum character limit for the specified memory block."
            }
          },
          "required": [
            "agent_id",
            "block_label",
            "new_block_limit"
          ]
        }
      },
      "args_json_schema": {},
      "return_char_limit": 50000,
      "pip_requirements": [],
      "npm_requirements": null,
      "default_requires_approval": null,
      "enable_parallel_execution": false,
      "created_by_id": "user-58451ab0-1df5-4200-9912-3aae90630d7e",
      "last_updated_by_id": "user-58451ab0-1df5-4200-9912-3aae90630d7e",
      "metadata_": {
        "tool_hash": "ab719bc84e78"
      },
      "project_id": null
    },
    {
      "id": "tool-12",
      "tool_type": "custom",
      "description": "Fetch file contents from a GitHub repository via the GitHub API.\n\nThis tool reads any file from a public GitHub repository and returns its contents\nas a string. Perfect for viewing HTML, code, or configuration files without needing\nmanual copy-paste.\n\nExamples:\n        >>> read_github_file(\"golaunchmate\", \"golaunchmate.github.io\", \"index.html\")\n        \"<!DOCTYPE html>...\"\n        \n        >>> read_github_file(\"golaunchmate\", \"laura-update\", \"index.html\", branch=\"develop\")\n        \"<!DOCTYPE html>...\"",
      "source_type": "json",
      "name": "read_github_file",
      "tags": [
        "github",
        "file-reading",
        "api",
        "automation"
      ],
      "source_code": "import requests\nimport base64\nfrom typing import Optional\n\ndef read_github_file(repo_owner: str, repo_name: str, file_path: str, branch: str = \"main\") -> str:\n    \"\"\"Fetch file contents from a GitHub repository via the GitHub API.\n    \n    This tool reads any file from a public GitHub repository and returns its contents\n    as a string. Perfect for viewing HTML, code, or configuration files without needing\n    manual copy-paste.\n    \n    Args:\n        repo_owner (str): GitHub username or organization name that owns the repository.\n        repo_name (str): Name of the GitHub repository.\n        file_path (str): Path to the file within the repository (e.g., \"index.html\", \"src/app.py\").\n        branch (str, optional): Branch name to read from. Defaults to \"main\".\n    \n    Returns:\n        str: The decoded file contents as a string, or an error message if the fetch fails.\n    \n    Examples:\n        >>> read_github_file(\"username\", \"my-website\", \"index.html\")\n        \"<!DOCTYPE html>...\"\n        \n        >>> read_github_file(\"organization\", \"project-repo\", \"index.html\", branch=\"develop\")\n        \"<!DOCTYPE html>...\"\n    \"\"\"\n    try:\n        # GitHub API endpoint for file contents\n        url = f\"https://api.github.com/repos/{repo_owner}/{repo_name}/contents/{file_path}\"\n        \n        # Add branch parameter if not default\n        params = {\"ref\": branch} if branch else {}\n        \n        # Make API request\n        response = requests.get(url, params=params)\n        \n        # Check if request was successful\n        if response.status_code == 404:\n            return f\"❌ Error: File '{file_path}' not found in {repo_owner}/{repo_name} (branch: {branch})\"\n        elif response.status_code != 200:\n            return f\"❌ Error: GitHub API returned status {response.status_code}: {response.text}\"\n        \n        # Parse JSON response\n        data = response.json()\n        \n        # Check if it's a file (not a directory)\n        if data.get(\"type\") != \"file\":\n            return f\"❌ Error: '{file_path}' is a {data.get('type')}, not a file\"\n        \n        # Decode base64 content\n        content_base64 = data.get(\"content\", \"\")\n        content_decoded = base64.b64decode(content_base64).decode(\"utf-8\")\n        \n        return content_decoded\n        \n    except requests.exceptions.RequestException as e:\n        return f\"❌ Network error: {str(e)}\"\n    except Exception as e:\n        return f\"❌ Unexpected error: {str(e)}\"\n",
      "json_schema": {
        "name": "read_github_file",
        "description": "Fetch file contents from a GitHub repository via the GitHub API.\n\nThis tool reads any file from a public GitHub repository and returns its contents\nas a string. Perfect for viewing HTML, code, or configuration files without needing\nmanual copy-paste.\n\nExamples:\n        >>> read_github_file(\"golaunchmate\", \"golaunchmate.github.io\", \"index.html\")\n        \"<!DOCTYPE html>...\"\n        \n        >>> read_github_file(\"golaunchmate\", \"laura-update\", \"index.html\", branch=\"develop\")\n        \"<!DOCTYPE html>...\"",
        "parameters": {
          "type": "object",
          "properties": {
            "repo_owner": {
              "type": "string",
              "description": "GitHub username or organization name that owns the repository."
            },
            "repo_name": {
              "type": "string",
              "description": "Name of the GitHub repository."
            },
            "file_path": {
              "type": "string",
              "description": "Path to the file within the repository (e.g., \"index.html\", \"src/app.py\")."
            },
            "branch": {
              "type": "string",
              "description": "Branch name to read from. Defaults to \"main\"."
            }
          },
          "required": [
            "repo_owner",
            "repo_name",
            "file_path"
          ]
        }
      },
